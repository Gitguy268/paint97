{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Third-party bundles copied in as built (see public/vendor/wllama/README.md).
  "ignorePatterns": ["public/vendor/**"],
  "plugins": ["react", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Noisy against this stack: the automatic JSX runtime makes the React
    // import unnecessary, and `__xss` sentinel params in the e2e suite are
    // intentionally underscore-prefixed.
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    // Selected pedantic rules that pay for themselves with zero false
    // positives here: promise-fidelity mocks, promise executors that leak a
    // return value, useless fragments and `!=` vs `!==`.
    "eslint/require-await": "error",
    "eslint/no-promise-executor-return": "error",
    "react/jsx-no-useless-fragment": "error",
    "eslint/eqeqeq": "error"
  }
}
